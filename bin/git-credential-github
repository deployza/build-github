#!/bin/bash
# -----------------------------------------------------------------------------
# git-credential-github — git's credential helper for https://github.com.
#
# Installed to /usr/local/bin/git-credential-github by build-github, and named
# in git's system config as
#
#   [credential "https://github.com"]
#       helper = github
#
# git runs `git credential-github get` when it needs a password and writes the
# request (protocol=, host=, ...) on stdin. This answers with a token from
# github-token, beside it; store and erase are ignored — there is nothing to
# store, every answer is fetched or minted fresh.
#
# WHY A HELPER AND NOT A TOKEN IN THE URL. https://x-access-token:<token>@github.com/...
# puts the token on argv, where `ps` shows it, and git then persists it in the
# clone's .git/config. Through a helper it is in no URL and no file.
#
# NO `set -x` — this script prints the token.
# -----------------------------------------------------------------------------
set -euo pipefail

[[ "${1:-}" == get ]] || exit 0

protocol="" host=""
while IFS= read -r line && [[ -n "$line" ]]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*)     host="${line#host=}" ;;
  esac
done

# Only github.com over HTTPS. Anything else: say nothing, and git moves on.
[[ "$protocol" == https && "$host" == github.com ]] || exit 0

token="$("$(dirname "${BASH_SOURCE[0]}")/github-token")" || exit 1

# x-access-token is GitHub's documented placeholder username; it authenticates
# on the password, for a PAT and an App installation token alike.
printf 'username=x-access-token\npassword=%s\n' "$token"
